# Copy this file to .env and fill in real values. .env is git-ignored;
# this template is not, so it's safe to commit placeholder keys.
#
# On Streamlit Community Cloud, set these same names under Settings ->
# Secrets instead of committing a .env file -- see config.py.

# Anthropic Claude -- required for LLM news-sentiment scoring.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: OpenAI, used as the alternate sentiment provider.
# OPENAI_API_KEY=sk-...

# Optional: force a provider when both keys above are set ("claude" | "openai").
# SENTIMENT_LLM_PROVIDER=claude

# Optional: override the default Claude model/reasoning effort.
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=medium

# Optional: yfinance network settings. Leave unset to use yfinance's own
# defaults (no proxy, its built-in retry count).
# YFINANCE_PROXY=http://user:pass@proxy.example.com:8080
# YFINANCE_RETRIES=3
